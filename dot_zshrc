export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Claude Code の PowerShell ツールを読み込ませない。
# 組織配信の ~/.claude/remote-settings.json は "0" を設定しているが、判定は値ではなく
# 「空でないか」なので "0" でも有効になる。空文字にするとツールごと出なくなる。
# このマシンに pwsh は入っていないため、有効なままだと Windows 前提の説明文だけが
# プロンプトに載り、zsh に PowerShell の記法が持ち込まれる。
export CLAUDE_CODE_USE_POWERSHELL_TOOL=""

# OpenSpec shell completions
fpath=("$HOME/.zsh/completions" $fpath)
fpath+=~/.zfunc

# Tool initializations (with existence guards)
command -v sheldon > /dev/null && eval "$(sheldon source)"
command -v mise > /dev/null && eval "$(mise activate zsh)"
command -v starship > /dev/null && eval "$(starship init zsh)"
command -v direnv > /dev/null && eval "$(direnv hook zsh)"
command -v git-wt > /dev/null && eval "$(git wt --init zsh)"

source ~/.config/zsh/alias.zsh
source ~/.config/zsh/fzf.zsh
source ~/.config/zsh/ghq.zsh
source ~/.config/zsh/history.zsh
[ -f ~/.zshrc_local ] && source ~/.zshrc_local

setopt interactivecomments

# Completion
zstyle ':completion:*' menu select
zstyle ':completion:*' verbose yes
zstyle ':completion:*' format '%B%d%b'
zstyle ':completion:*:warnings' format 'No matches for: %d'
zstyle ':completion:*' group-name ''

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# bun
export PATH="$HOME/.bun/bin:$PATH"
