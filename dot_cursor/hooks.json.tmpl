{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/main-repo-shell-guard.ts",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/main-branch-guard.ts",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/force-push-guard.ts",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/gh-comment-format-guard.ts",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/secret-file-guard.ts",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/secret-file-guard.ts",
        "matcher": "Write|StrReplace|Delete|EditNotebook|ApplyPatch",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/main-repo-guard.ts",
        "matcher": "Write|StrReplace|Delete|EditNotebook|ApplyPatch",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/main-repo-shell-guard.ts",
        "matcher": "Shell",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/main-branch-guard.ts",
        "matcher": "Shell",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/force-push-guard.ts",
        "matcher": "Shell",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/gh-comment-format-guard.ts",
        "matcher": "Shell",
        "failClosed": true
      },
      {
        "command": "bun {{ .chezmoi.homeDir }}/.cursor/hooks/webfetch-guard.ts",
        "matcher": "WebFetch",
        "failClosed": true
      }
    ]
  }
}
