---
type MermaidPolicy = Readonly<{
  kind: "mermaid";
  nonce: string;
  csp: string;
  cdnUrl: "https://cdn.jsdelivr.net/npm/mermaid@11.16.0/dist/mermaid.min.js";
  initScript: string;
}>;

const { policy } = Astro.props as { policy: MermaidPolicy };
---

<script is:inline src={policy.cdnUrl} nonce={policy.nonce}></script>
<script is:inline nonce={policy.nonce} set:html={policy.initScript}></script>
