#!/usr/bin/env bun

import {
  readActivities,
  recordActivity,
  type ActivitySource,
} from "../lib/worktree-activity";

const usage = "usage: worktree-activity record <claude|codex|nvim> <cwd> | worktree-activity list\n";
const [command, source, cwd] = process.argv.slice(2);
const sources = new Set<ActivitySource>(["claude", "codex", "nvim"]);

if (command === "list" && source === undefined) {
  process.stdout.write(`${JSON.stringify(await readActivities())}\n`);
} else if (command === "record" && source && cwd && sources.has(source as ActivitySource)) {
  process.stdout.write(
    `${JSON.stringify(await recordActivity(cwd, source as ActivitySource))}\n`,
  );
} else {
  process.stderr.write(usage);
  process.exitCode = 2;
}
