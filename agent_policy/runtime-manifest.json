{
  "runtimes": {
    "codex": {
      "home": "~/.codex",
      "rules": "dot_codex/rules",
      "skills": "dot_codex/skills",
      "hooks": "dot_codex/hooks.json",
      "hookRoles": {
        "force-push-guard": "dot_codex/hooks/executable_force-push-guard.ts",
        "gh-comment-format-guard": "dot_codex/hooks/executable_gh-comment-format-guard.ts",
        "main-branch-guard": "dot_codex/hooks/executable_main-branch-guard.ts",
        "main-repo-guard": "dot_codex/hooks/executable_main-repo-guard.ts",
        "plan-export": "dot_codex/hooks/executable_plan-export.ts",
        "secret-file-guard": "dot_codex/hooks/executable_secret-file-guard.ts",
        "session-init": "dot_codex/hooks/executable_session-init.ts",
        "shell-policy-guard": "dot_codex/hooks/executable_shell-policy-guard.ts",
        "webfetch-guard": "dot_codex/hooks/executable_webfetch-guard.ts",
        "worktree": "dot_codex/hooks/executable_worktree.ts"
      },
      "requiredRules": [
        "communication-style.md",
        "shell-command-style.md",
        "subagent-tool-usage.md",
        "secret-file-access.md",
        "commit-message.md",
        "worktree-workflow.md"
      ]
    },
    "claude": { "home": "~/.claude", "rules": "dot_claude/rules", "skills": "dot_claude/skills", "hooks": "dot_claude/modify_settings.json.tmpl" },
    "cursor": { "home": "~/.cursor", "rules": "dot_cursor/rules", "skills": "dot_cursor/skills", "hooks": "dot_cursor/hooks.json" }
  }
}
